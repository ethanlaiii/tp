CommandBox -down-|> UiPart
ResultDisplay -down-|> UiPart
StatusBarFooter -down-|> UiPart
PersonListPanel -down-|> UiPart
StudentDetailPanel -down-|> UiPart
PersonCard -left-|> UiPart
MainWindow -down-|> UiPart

PersonCard ..> Model
StudentDetailPanel ..> Model

CommandBox -[hidden]right- ResultDisplay
ResultDisplay -[hidden]right- StatusBarFooter
StatusBarFooter -[hidden]right- PersonListPanel
PersonListPanel -[hidden]right- StudentDetailPanel

