@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class Person
Class Name
Class Phone
Class School
Class Address
Class Email
Class "<<enumeration>>\nLevel" as Level
Class Subject
Class "<<enumeration>>\nBand" as Band
Class Note
Class Guardian
Class Tag
}

Person *--> "1" Name
Person *--> "0..1" Guardian
Person *--> "0..1" Phone
Person *--> "1" School
Person *--> "0..1" Address
Person *--> "0..1" Email
Person --> "1" Level
Person *--> "1..8" Subject
Person *--> "~* {ordered}" Note
Person *--> "~*" Tag

Subject --> "1" Band

Guardian *-left-> "1" Name
Guardian *-right-> "1" Phone
@enduml
