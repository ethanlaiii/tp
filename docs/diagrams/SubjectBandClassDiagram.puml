@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
skinparam classAttributeFontColor #FFFFFF

Package Model as ModelPackage <<Rectangle>> {
    Class Person
    Class Subject
    Class "<<enumeration>>\nBand" as Band {
        G1
        G2
        G3
    }
}

show Band fields
hide <<Rectangle>> stereotype

Person *-right-> "1..8" Subject : subjects
Subject -right-> "1" Band : band
@enduml
